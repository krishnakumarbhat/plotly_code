# opencode secrets (DO NOT COMMIT)
# Source this file in your shell rc: source ~/.config/opencode/.env
# Replace placeholder values below with your actual API keys.

# OpenCode Zen Gateway (primary provider)
export OPENCODE_ZEN_API_KEY=sk-your-opencode-zen-key

# OpenRouter (fallback)
export OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key

# Google AI Studio (last resort fallback)
export GOOGLE_API_KEY=your-google-ai-studio-key

# Composio MCP
export COMPOSIO_MCP_API_KEY=ak-your-composio-mcp-key

# Composio CLI
export COMPOSIO_API_KEY=ak-your-composio-cli-key
