{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "subagent_depth": 2,
  "plugin": [
    "./.opencode/plugins/ponytail.mjs",
    "./plugins/dynamic-context-prune.mjs"
  ],
  "mcp": {
    "composio": {
      "type": "remote",
      "url": "https://connect.composio.dev/mcp",
      "enabled": true,
      "environment": {
        "COMPOSIO_API_KEY": "{env:COMPOSIO_MCP_API_KEY}"
      }
    }
  },
  "provider": {
    "opencode": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OpenCode Zen Gateway",
      "options": {
        "apiKey": "{env:OPENCODE_ZEN_API_KEY}"
      },
      "models": {
        "deepseek-v4-flash-free": {
          "name": "DeepSeek V4 Flash Free",
          "options": {
            "thinking": { "type": "enabled" },
            "reasoningEffort": "max"
          }
        },
        "big-pickle": {
          "name": "Big Pickle",
          "options": {
            "reasoningEffort": "max"
          }
        },
        "hy3-free": {
          "name": "Hy3 Free"
        },
        "north-mini-code-free": {
          "name": "North Mini Code Free"
        }
      }
    },
    "openrouter": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OpenRouter Fallback",
      "options": {
        "apiKey": "{env:OPENROUTER_API_KEY}",
        "baseURL": "https://openrouter.ai/api/v1"
      },
      "models": {
        "nvidia/nemotron-3-ultra-550b-a55b:free": {
          "name": "Nemotron 3 Ultra 550B",
          "options": {
            "reasoningEffort": "high"
          }
        },
        "nvidia/nemotron-3-super-120b-a12b:free": {
          "name": "Nemotron 3 Super 120B",
          "options": {
            "reasoningEffort": "high"
          }
        },
        "google/gemma-4-26b-a4b-it:free": {
          "name": "Gemma 4 26B"
        }
      }
    },
    "google": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Google AI Studio (last resort)",
      "options": {
        "apiKey": "{env:GOOGLE_API_KEY}",
        "baseURL": "https://generativelanguage.googleapis.com/v1beta/openai/"
      },
      "models": {
        "models/gemini-3.6-flash": {
          "name": "Gemini 3.6 Flash (fallback)",
          "options": { "reasoningEffort": "high" }
        },
        "models/gemini-3.5-flash": {
          "name": "Gemini 3.5 Flash (fallback)",
          "options": { "reasoningEffort": "high" }
        },
        "models/gemini-3.5-flash-lite": {
          "name": "Gemini 3.5 Flash Lite (fallback)",
          "options": { "reasoningEffort": "medium" }
        },
        "models/gemini-3.1-flash-lite": {
          "name": "Gemini 3.1 Flash Lite (fallback)",
          "options": { "reasoningEffort": "medium" }
        }
      }
    }
  },
  "model": "opencode/deepseek-v4-flash-free",
  "small_model": "opencode/north-mini-code-free",
  "agent": {
    "plan": {
      "mode": "primary",
      "model": "opencode/big-pickle",
      "description": "Architectural planner. Uses Big Pickle for deep creative reasoning."
    },
    "build": {
      "mode": "primary",
      "model": "opencode/deepseek-v4-flash-free",
      "description": "Primary builder. Uses DeepSeek V4 Flash for broad coding tasks."
    },
    "coder": {
      "mode": "subagent",
      "model": "opencode/deepseek-v4-flash-free",
      "description": "Multi-file coding subagent with full tool access."
    },
    "researcher": {
      "mode": "subagent",
      "model": "opencode/deepseek-v4-flash-free",
      "description": "/autoresearch orchestrator. Can delegate to sub-subagents for multi-model research."
    },
    "explorer": {
      "mode": "subagent",
      "model": "opencode/north-mini-code-free",
      "description": "Fast codebase exploration."
    }
  }
}
